{
  "name": "braingrain-alexa-mcp",
  "version": "0.1.0",
  "description": "Brain Grain Quiz Coach — a self-hosted MCP server that turns Alexa+ (or any MCP client) into a bilingual Tamil/English exam coach for TNPSC, UPSC and CTET.",
  "type": "module",
  "main": "src/server.js",
  "bin": {
    "braingrain-mcp": "src/stdio.js"
  },
  "scripts": {
    "start": "node src/server.js",
    "stdio": "node src/stdio.js",
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "cors": "2.8.5",
    "express": "5.2.1",
    "zod": "3.25.76"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/scoretracker4321/braingrain-alexa-mcp"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "alexa",
    "alexa-plus",
    "quiz",
    "tnpsc",
    "upsc",
    "tamil",
    "education"
  ]
}
